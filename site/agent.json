{
  "name": "2047 Binary Merge",
  "version": 3,
  "documentation": "./api.html",
  "javascript": "window.game2047",
  "stateSelector": "#game-state",
  "changeEvent": "game2047:change",
  "grid": {
    "selector": "#board",
    "cellSelector": "[role=gridcell]",
    "attributes": [
      "data-row",
      "data-column",
      "data-value"
    ],
    "order": "row-major",
    "empty": 0,
    "indexBase": 0
  },
  "directions": [
    "up",
    "right",
    "down",
    "left"
  ],
  "modes": [
    "classic",
    "insane",
    "2048"
  ],
  "methods": [
    "getState",
    "move",
    "newGame",
    "undo",
    "redo",
    "shareURL"
  ],
  "webmcpTools": [
    "game2047_get_state",
    "game2047_move",
    "game2047_new_game",
    "game2047_undo",
    "game2047_redo"
  ],
  "urlParameters": [
    "seed",
    "mode",
    "size",
    "rows",
    "cols",
    "moves",
    "board",
    "score",
    "controls",
    "bits",
    "display",
    "sound",
    "volume",
    "theme",
    "motion",
    "save",
    "timer"
  ],
  "reproducibleExample": "./?seed=hello&mode=classic&size=4&save=0",
  "randomness": {
    "default": "random",
    "seedProvided": "seeded",
    "randomSnapshot": "Restores position; future tiles use fresh randomness",
    "seededSnapshot": "Preserves deterministic continuation",
    "startingSeedLink": "Seeded games only"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "assessment": {
    "defaultEnabled": false,
    "defaultPresetSeconds": 120,
    "timeLimitSeconds": [
      0,
      3600
    ],
    "newGameOption": "timeLimit",
    "deadline": "Absolute; continues through menus, background tabs, and reloads",
    "resultPath": "getState().assessment.result",
    "expiredActions": "move, undo, and redo return changed false with reason timeout",
    "shareFragment": "#round=",
    "newGameConfirmation": "A nonzero score returns needsConfirmation without changing the game; confirm:true explicitly replaces it"
  },
  "timerEvent": "game2047:timer",
  "milestoneEvent": "game2047:milestone"
}
